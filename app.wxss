/* app.wxss —— 全局公共样式 */

page {
  /* 全局主题色 */
  --primary: #FF5630;
  --primary-light: #FF8A50;
  --bg: #F5F6F7;
  --card: #FFFFFF;
  --text: #2B2F36;
  --text-sub: #8A9099;
  --success: #07C160;
  --warning: #FF9F0A;
  --danger: #FA5151;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  border: none;
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  background: #FFC9B8;
  color: #FFFFFF;
}

/* 状态徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.badge-pending {
  background: #FFF3E0;
  color: #E68A00;
}
.badge-pass {
  background: #E8F8EE;
  color: #07A653;
}
.badge-wait {
  background: #E8F0FE;
  color: #1A73E8;
}
.badge-reject {
  background: #FDE8E8;
  color: #D93025;
}

/* 表单标签 */
.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.form-label .required {
  color: var(--danger);
  margin-right: 4rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-sub);
  padding: 120rpx 40rpx;
  font-size: 28rpx;
}
.empty .empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}
