/* pages/adminDetail/adminDetail.wxss */

.page-detail {
  min-height: 100vh;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-dept {
  font-size: 34rpx;
  font-weight: 700;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.intro-box {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 24rpx;
}

.intro-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* 详情页：完整显示，强制在框内换行（含超长无空格串） */
.intro-text {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
}

.action-bar button {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
}

.action-bar button::after {
  border: none;
}

.btn-pass {
  background: var(--success);
  color: #FFFFFF;
}

.btn-wait {
  background: #F5F6F7;
  color: var(--text);
}

.loading {
  text-align: center;
  color: var(--text-sub);
  padding: 120rpx 40rpx;
}
