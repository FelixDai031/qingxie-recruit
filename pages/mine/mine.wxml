<view class="page-mine">
  <!-- 顶部用户区 -->
  <view class="user-card">
    <!-- 已登录 -->
    <block wx:if="{{logged}}">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar-fallback">🙂</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '同学'}}</text>
        <text class="user-id" wx:if="{{openid}}" bindtap="copyOpenid">ID：{{openid}}（点击复制）</text>
      </view>
      <view class="logout-btn" bindtap="doLogout">退出登录</view>
    </block>

    <!-- 未登录 -->
    <block wx:else>
      <view class="user-avatar">
        <text class="avatar-fallback">🙂</text>
      </view>
      <view class="user-info" bindtap="showLogin">
        <text class="user-name">点击登录</text>
        <text class="user-id">登录后查看我的报名</text>
      </view>
      <view class="login-arrow" bindtap="showLogin">▸</view>
    </block>
  </view>

  <!-- 登录弹窗 -->
  <view wx:if="{{showLogin}}" class="login-mask" bindtap="hideLogin">
    <view class="login-panel" catchtap="stopPropagation">
      <view class="login-title">微信登录</view>
      <view class="login-desc">登录后可同步你的报名记录</view>

      <form bindsubmit="doLogin">
        <!-- 头像选择 -->
        <button class="avatar-picker" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{tempAvatar}}" class="picker-img" src="{{tempAvatar}}" mode="aspectFill" />
          <view wx:else class="picker-placeholder">
            <text class="picker-icon">📷</text>
            <text class="picker-text">点击使用微信头像</text>
          </view>
        </button>

        <!-- 昵称输入 -->
        <view class="nick-row">
          <input name="nickName" class="nick-input" type="nickname" placeholder="点击输入昵称" placeholder-class="ph" value="{{tempNick}}" bindinput="onNickInput" cursor-spacing="20" />
        </view>

        <view class="login-actions">
          <button class="btn-cancel" bindtap="hideLogin">取消</button>
          <button class="btn-primary btn-confirm" form-type="submit" loading="{{logging}}">确认登录</button>
        </view>
      </form>
    </view>
  </view>

  <!-- 报名列表 -->
  <view class="card apply-card">
    <view class="section-title">我的报名</view>

    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:elif="{{applications.length}}">
      <view wx:for="{{applications}}" wx:key="_id" class="apply-item">
        <view class="apply-header">
          <text class="apply-dept">{{item.deptName}}</text>
          <text class="badge {{item.status === 'pending' ? 'badge-pending' : (item.status === 'pass' ? 'badge-pass' : 'badge-wait')}}">{{item.statusText}}</text>
        </view>
        <view class="apply-meta">
          <text>姓名：{{item.name}}</text>
          <text>手机号：{{item.maskPhone}}</text>
          <text>提交时间：{{item.timeText}}</text>
        </view>
      </view>
    </block>

    <view wx:else class="empty">
      <text class="empty-icon">📝</text>
      <text>暂无报名记录</text>
      <button class="btn-primary btn-empty" bindtap="goApply">去报名</button>
    </view>
  </view>

  <!-- 管理员入口 / 申请认证 -->
  <view wx:if="{{isAdmin}}" class="card admin-entry" bindtap="goAdmin">
    <text class="admin-title">管理员入口</text>
    <text class="admin-arrow">▸</text>
  </view>
  <view wx:elif="{{logged && !isAdmin}}" class="card admin-apply" bindtap="openApplySheet">
    <view class="admin-apply-main">
      <text class="admin-title">申请管理员认证</text>
      <text class="admin-sub">点击在线提交申请，需先填写你的姓名/备注，负责人审核通过后即可审核报名</text>
    </view>
    <text class="admin-arrow">▸</text>
  </view>

  <!-- 申请管理员弹层（点击卡片后弹出，填写姓名/备注后才能提交） -->
  <view wx:if="{{applySheetVisible}}" class="apply-mask" bindtap="closeApplySheet">
    <view class="apply-panel" catchtap="stopPropagation">
      <view class="apply-title">申请管理员认证</view>
      <view class="apply-desc">请填写你的姓名/备注，方便负责人识别；通过后将获得全部部门审核权限。</view>

      <view class="apply-field">
        <text class="apply-label"><text class="apply-required">*</text> 姓名 / 备注</text>
        <input
          class="apply-input"
          placeholder="例如：李四 2024级 校青协"
          placeholder-class="ph"
          value="{{applyName}}"
          bindinput="onApplyNameInput"
          maxlength="30"
          cursor-spacing="20"
        />
      </view>

      <view class="apply-field">
        <text class="apply-label">补充说明（可选）</text>
        <textarea
          class="apply-textarea"
          placeholder="例如：负责 XX 部门招新 / 已被面试官 X 老师推荐"
          placeholder-class="ph"
          value="{{applyRemark}}"
          bindinput="onApplyRemarkInput"
          maxlength="200"
          auto-height
        />
      </view>

      <view class="apply-actions">
        <button class="btn-cancel" bindtap="closeApplySheet">取消</button>
        <button class="btn-primary btn-confirm" bindtap="submitApplyAdmin" loading="{{applySubmitting}}" disabled="{{applySubmitting || !applyName}}">提交申请</button>
      </view>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
