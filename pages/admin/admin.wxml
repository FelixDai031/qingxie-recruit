<view class="page-admin">
  <!-- 权限校验失败 -->
  <view wx:if="{{!loading && !isAdmin}}" class="empty">
    <text class="empty-icon">🚫</text>
    <text>你没有管理员权限</text>
  </view>

  <!-- 审核列表 -->
  <block wx:elif="{{isAdmin}}">
    <!-- 顶部功能切换 -->
    <view class="admin-tabs">
      <view class="admin-tab {{adminTab === 'review' ? 'active' : ''}}" hover-class="btn-hover" hover-stay-time="120" bindtap="switchAdminTab" data-tab="review">报名审核</view>
      <view class="admin-tab {{adminTab === 'manage' ? 'active' : ''}}" hover-class="btn-hover" hover-stay-time="120" bindtap="switchAdminTab" data-tab="manage">管理设置</view>
    </view>

    <!-- 部门管理员的权限范围提示 -->
    <view wx:if="{{myDeptNames}}" class="scope-tip">
      <text class="scope-icon">🔐</text>
      <text class="scope-text">你的管理范围：{{myDeptNames}}</text>
    </view>

    <!-- ===== Tab 1：报名审核 ===== -->
    <block wx:if="{{adminTab === 'review'}}">
    <view class="filter-bar">
      <view class="filter-item {{filter === 'pending' ? 'active' : ''}}" bindtap="setFilter" data-type="pending">
        待审核
        <text wx:if="{{stats.pending}}" class="filter-badge">{{stats.pending}}</text>
      </view>
      <view class="filter-item {{filter === 'pass' ? 'active' : ''}}" bindtap="setFilter" data-type="pass">已通过</view>
      <view class="filter-item {{filter === 'reject' ? 'active' : ''}}" bindtap="setFilter" data-type="reject">不通过</view>
      <view class="filter-item {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-type="all">全部</view>
    </view>

    <view class="export-bar">
      <block wx:if="{{!selectMode}}">
        <button class="btn-mode" hover-class="btn-hover" hover-stay-time="120" bindtap="enterSelect">选择</button>
        <button class="btn-export" hover-class="btn-hover" hover-stay-time="120" bindtap="exportTable" loading="{{exporting}}">导出当前筛选为 Excel</button>
      </block>
      <block wx:else>
        <view class="export-info">
          <text class="sel-count">已选 {{selectedIds.length}} 项</text>
          <text class="sel-all" catchtap="toggleSelectAll">{{allSelected ? '取消全选' : '全选'}}</text>
          <text class="sel-cancel" catchtap="exitSelect">取消</text>
        </view>
        <button class="btn-export" hover-class="btn-hover" hover-stay-time="120" bindtap="exportTable" loading="{{exporting}}">导出选中为 Excel</button>
      </block>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <view wx:elif="{{list.length === 0}}" class="empty">
      <text class="empty-icon">✅</text>
      <text>该状态下暂无报名</text>
    </view>

    <view wx:for="{{list}}" wx:key="_id" class="card apply-card {{item.status === 'pending' ? 'st-pending' : (item.status === 'pass' ? 'st-pass' : (item.status === 'reject' ? 'st-reject' : 'st-wait'))}}" bindtap="goDetail" data-id="{{item._id}}">
      <view class="apply-header">
        <view wx:if="{{selectMode}}" class="select-dot {{item.selected ? 'selected' : ''}}" catchtap="toggleSelect" data-id="{{item._id}}">{{item.selected ? '✓' : ''}}</view>
        <text class="apply-dept">{{item.deptName}}</text>
        <text class="badge {{item.status === 'pending' ? 'badge-pending' : (item.status === 'pass' ? 'badge-pass' : (item.status === 'reject' ? 'badge-reject' : 'badge-wait'))}}">{{item.statusText}}</text>
      </view>
      <view class="info-list">
        <text>姓名：{{item.name}}</text>
        <text>学号：{{item.stuId}}</text>
        <text>学院：{{item.college}}</text>
        <text wx:if="{{item.major}}">专业：{{item.major}}</text>
        <text>手机：{{item.phone}}</text>
        <text>提交：{{item.timeText}}</text>
      </view>
      <view class="intro-box">
        <text class="intro-label">自我介绍</text>
        <text class="intro-text {{item.expanded ? '' : 'collapsed'}}">{{item.intro}}</text>
        <text wx:if="{{item.longIntro}}" class="intro-toggle" catchtap="toggleExpand" data-id="{{item._id}}">{{item.expanded ? '收起 ▲' : '展开查看完整简介 ▼'}}</text>
      </view>
      <view class="detail-hint">点击卡片查看完整信息 ›</view>
      <view wx:if="{{item.status === 'pending'}}" class="action-bar">
        <button class="btn-pass" hover-class="btn-hover" hover-stay-time="120" catchtap="review" data-id="{{item._id}}" data-status="pass" data-dept="{{item.deptName}}" data-openid="{{item._openid}}">通过</button>
        <button class="btn-wait" hover-class="btn-hover" hover-stay-time="120" catchtap="review" data-id="{{item._id}}" data-status="wait" data-dept="{{item.deptName}}" data-openid="{{item._openid}}">待定</button>
        <button class="btn-reject" hover-class="btn-hover" hover-stay-time="120" catchtap="review" data-id="{{item._id}}" data-status="reject" data-dept="{{item.deptName}}" data-openid="{{item._openid}}">驳回</button>
      </view>
      <view wx:elif="{{item.status === 'pass' || item.status === 'wait' || item.status === 'reject'}}" class="action-bar">
        <button class="btn-reset" hover-class="btn-hover" hover-stay-time="120" catchtap="review" data-id="{{item._id}}" data-status="pending" data-dept="{{item.deptName}}" data-openid="{{item._openid}}">撤销审核 · 重置为待审核</button>
      </view>
    </view>

    <view style="height:40rpx;"></view>
    </block>

    <!-- ===== Tab 2：管理设置 ===== -->
    <block wx:else>
      <!-- 审核总览（统计看板） -->
      <view class="card stats-card">
        <view class="stats-head">
          <view class="add-admin-title">审核总览</view>
          <text class="stats-total">共 {{stats.total}} 人报名</text>
        </view>
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-num num-pending">{{stats.pending}}</text>
            <text class="stat-label">待审核</text>
          </view>
          <view class="stat-item">
            <text class="stat-num num-pass">{{stats.pass}}</text>
            <text class="stat-label">已通过</text>
          </view>
          <view class="stat-item">
            <text class="stat-num num-wait">{{stats.wait}}</text>
            <text class="stat-label">待定</text>
          </view>
          <view class="stat-item">
            <text class="stat-num num-reject">{{stats.reject}}</text>
            <text class="stat-label">不通过</text>
          </view>
        </view>
        <view wx:if="{{byDept.length}}" class="dept-stats">
          <view class="dept-stats-title">各部门报名人数</view>
          <view wx:for="{{byDept}}" wx:key="name" class="dept-stat-row">
            <text class="ds-name">{{item.name}}</text>
            <view class="ds-bar-wrap">
              <view class="ds-bar" style="width: {{maxDeptCount ? (item.count / maxDeptCount * 100) : 0}}%"></view>
            </view>
            <text class="ds-count">{{item.count}}</text>
          </view>
        </view>
      </view>

      <!-- 招新设置（报名开关） -->
      <view class="card recruit-setting-card">
        <view class="recruit-row">
          <view class="recruit-info">
            <view class="add-admin-title">开放报名</view>
            <view class="add-admin-desc">{{recruitOpen ? '学生当前可以提交报名表' : '报名已关闭，学生端无法提交'}}</view>
          </view>
          <switch checked="{{recruitOpen}}" color="#FF5630" bindchange="toggleRecruitOpen" disabled="{{toggling}}" />
        </view>
      </view>

      <!-- 管理员管理入口 -->
      <view class="card admin-manage-card" hover-class="btn-hover" hover-stay-time="120" bindtap="goAdminManage">
        <view class="admin-manage-row">
          <view class="admin-manage-icon">⚙️</view>
          <view class="admin-manage-info">
            <view class="add-admin-title">管理员管理</view>
            <view class="add-admin-desc">添加/移除管理员、修改管理范围、审批申请。</view>
          </view>
          <text class="admin-manage-arrow">›</text>
        </view>
      </view>

      <!-- 部门简介管理 -->
      <view class="card dept-manage-card">
        <view class="add-admin-title">部门简介管理</view>
        <view class="add-admin-desc">点击进入后，先选择部门，再编辑其简介与标语，修改后在小程序部门详情页实时生效。</view>
        <button class="btn-enter-edit" hover-class="btn-hover" hover-stay-time="120" bindtap="goEditDept"><text>进入编辑</text><text class="enter-arrow">›</text></button>
      </view>

      <view style="height:40rpx;"></view>
    </block>
  </block>
</view>
