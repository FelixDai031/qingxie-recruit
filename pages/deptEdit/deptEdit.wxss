/* pages/deptEdit/deptEdit.wxss */
.page-edit {
  padding: 30rpx 30rpx 60rpx;
  min-height: 100vh;
  background: #F5F6F7;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.field-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 18rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  font-size: 29rpx;
  color: #1A1A1A;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 24rpx;
  background: #F5F6F7;
  border-radius: 14rpx;
  font-size: 29rpx;
  color: #1A1A1A;
}

.picker-ph {
  color: #B0B5BA;
}

.picker-arrow {
  color: #9AA0A6;
  font-size: 26rpx;
}

.empty-tip {
  text-align: center;
  color: #9AA0A6;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.field-textarea {
  width: 100%;
  min-height: 320rpx;
  font-size: 29rpx;
  line-height: 1.6;
  color: #1A1A1A;
}

.counter {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #B0B5BA;
  margin-top: 12rpx;
}

.tip {
  font-size: 24rpx;
  color: #9AA0A6;
  margin: 10rpx 10rpx 30rpx;
  line-height: 1.6;
}

.btn-save {
  background: #FF5630;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
}

.btn-save[loading] {
  opacity: 0.8;
}

/* ===== 活动相册管理 ===== */
.photo-hint {
  font-size: 24rpx;
  color: #9AA0A6;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  width: 185rpx;
  height: 185rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 32rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #F5F6F7;
  border: 2rpx dashed #C9CDD1;
  box-sizing: border-box;
}

.photo-add.uploading {
  opacity: 0.6;
}

.photo-add-icon {
  font-size: 52rpx;
  color: #9AA0A6;
  line-height: 1;
}

.photo-add-text {
  font-size: 22rpx;
  color: #9AA0A6;
}
