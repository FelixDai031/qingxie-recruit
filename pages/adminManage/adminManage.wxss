/* pages/adminManage/adminManage.wxss */

.page-admin-manage {
  min-height: 100vh;
  padding: 0 24rpx;
}

.btn-hover {
  opacity: 0.88;
  transform: translateY(2rpx);
}

/* ===== 通用卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

/* ===== 顶部双入口 ===== */
.entry-bar {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.entry-card {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.entry-add {
  background: linear-gradient(135deg, #FFF7F4, #FFFFFF);
  border: 2rpx solid #FFE0D1;
}

.entry-req {
  background: linear-gradient(135deg, #FFFDF3, #FFFFFF);
  border: 2rpx solid #FFECB3;
}

.entry-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

.entry-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.entry-sub {
  font-size: 22rpx;
  color: var(--text-sub);
}

.entry-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

/* ===== 统计条 ===== */
.stat-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 8rpx 8rpx;
}

.stat-main {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-sub {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ===== 返回条 ===== */
.back-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 4rpx 10rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.back-icon {
  font-size: 38rpx;
  line-height: 1;
}

/* ===== 管理员列表 ===== */
.list-card {
  margin-bottom: 20rpx;
}

.admin-row {
  border-top: 1rpx solid #F0F1F2;
}

.admin-row:first-of-type {
  border-top: none;
}

.admin-row-main {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.admin-avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}

.admin-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.admin-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.admin-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-tag {
  flex: none;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 500;
  line-height: 24rpx;
}

.admin-tag.self {
  background: #EEF2FF;
  color: #4C6FFF;
}

.admin-tag.boss {
  background: #FFF1EC;
  color: var(--primary);
}

.admin-tag.dept {
  background: #F5F6F7;
  color: var(--text-sub);
}

.admin-scope {
  font-size: 24rpx;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-right: 12rpx;
}

.admin-chevron {
  flex: none;
  margin-left: 10rpx;
  font-size: 34rpx;
  color: #C8C9CC;
  line-height: 1;
  font-weight: 400;
  transform: translateY(1rpx);
}

.admin-row.expanded .admin-chevron {
  color: var(--primary);
}

/* 展开编辑面板 */
.admin-edit-panel {
  margin-top: 6rpx;
  margin-bottom: 8rpx;
  padding: 22rpx;
  background: #FAFBFC;
  border-radius: 16rpx;
}

.admin-edit-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.admin-edit-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.btn-save,
.btn-cancel,
.btn-remove {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 0;
  border: none;
}

.btn-save::after,
.btn-cancel::after,
.btn-remove::after {
  border: none;
}

.btn-save {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #FFFFFF;
}

.btn-cancel {
  background: #F5F6F7;
  color: var(--text);
}

.btn-remove {
  background: #FFF1F1;
  color: #FF4D4F;
}

/* ===== 添加表单 ===== */
.form-card {
  margin-bottom: 20rpx;
}

.add-admin-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.add-admin-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.add-admin-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}

.add-admin-input {
  flex: 1;
  height: 84rpx;
  background: #F5F6F7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.add-admin-input:focus {
  border-color: var(--primary);
  background: #FFF7F4;
}

.add-admin-name-input {
  flex: none;
  width: 100%;
  margin-bottom: 16rpx;
}

.add-admin-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-admin-btn {
  width: 170rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  padding: 0;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(255, 86, 48, 0.22);
}

.add-admin-btn::after {
  border: none;
}

.add-admin-msg {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ===== 部门勾选 ===== */
.dept-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.dept-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #F5F6F7;
  color: var(--text-sub);
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.dept-chip.checked {
  background: #FFF1EC;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

.dept-chips.compact {
  margin-top: 0;
  margin-bottom: 0;
}

.dept-chips.compact .dept-chip {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
}

/* ===== 管理员申请审批 ===== */
.btn-notify {
  margin-bottom: 20rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: 2rpx solid var(--primary);
  padding: 0;
}

.btn-notify::after {
  border: none;
}

.admin-req-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0F1F2;
}

.admin-req-row:first-of-type {
  border-top: none;
}

.admin-req-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.admin-req-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-req-remark {
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  background: #F5F6F7;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  margin: 2rpx 0;
}

.admin-req-id {
  font-size: 22rpx;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-req-time {
  font-size: 22rpx;
  color: var(--text-sub);
}

.admin-req-btns {
  flex: none;
  display: flex;
  gap: 14rpx;
}

.req-btn {
  width: 110rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 0;
  border: none;
}

.req-btn::after {
  border: none;
}

.req-approve {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #FFFFFF;
}

.req-reject {
  background: #F5F6F7;
  color: var(--text-sub);
}

/* ===== 空状态 / 加载态 ===== */
.loading {
  text-align: center;
  color: var(--text-sub);
  padding: 80rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: var(--text-sub);
  font-size: 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.add-admin-hint {
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 40rpx 0;
}
